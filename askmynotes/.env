# ─────────────────────────────────────────────────────────────────
#  RAG Chatbot – Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Endee Server ─────────────────────────────────────────────────
ENDEE_BASE_URL=http://localhost:8080/api/v1
# Leave blank if authentication is disabled (default for local dev)
ENDEE_AUTH_TOKEN=

# ── Endee Index Settings ──────────────────────────────────────────
ENDEE_INDEX_NAME=rag_documents
EMBEDDING_DIMENSION=384

# ── LLM Configuration ─────────────────────────────────────────────
# Options: "anthropic" | "openai" | "ollama" | "mock"
LLM_PROVIDER=mock

GEMINI_API_KEY=your_anthropic_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4 etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama local LLM (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Retrieval Settings ─────────────────────────────────────────────
TOP_K_RESULTS=5
CHUNK_SIZE=400
CHUNK_OVERLAP=50
